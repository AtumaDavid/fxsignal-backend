generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Direction {
  LONG
  SHORT
  NEUTRAL
}

enum OutcomeStatus {
  PENDING
  HIT
  MISSED
  EXPIRED
  /// Withdrawn before the entry zone traded (the setup broke on an H1 close).
  CANCELLED
  /// Exited before target or stop on strong H1 evidence against the trade.
  CLOSED_EARLY
  /// Reached +1R, stop moved to entry, then closed there (0 pips).
  BREAKEVEN
}

enum OutcomeSource {
  DEMO
  LIVE
}

enum EventImpact {
  LOW
  MEDIUM
  HIGH
}

enum PredictionEngine {
  RULE_BASED
  DEEPSEEK
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  name              String
  passwordHash      String
  plan              String             @default("FREE")
  planStatus        String             @default("ACTIVE")
  stripeCustomerId  String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  trades            UserTrade[]
  /// Alert channels and events (see src/lib/alerts.ts for the shape/defaults).
  alertPrefs        Json?
  /// External alert destinations (Telegram chat, Discord/webhook URLs); see externalAlerts.ts.
  alertTargets      Json?
  /// Risk guardrails: daily loss limit and max trades per day (off by default).
  riskPrefs         Json?
  /// Last authenticated request (updated at most every few minutes).
  lastSeenAt        DateTime?
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  @@index([email])
}

model CurrencyPair {
  code          String       @id
  displayName   String
  baseCurrency  String
  quoteCurrency String
  pipSize       Decimal      @db.Decimal(10, 6)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  predictions   Prediction[]
}

model Prediction {
  id                Int                @id @default(autoincrement())
  pairCode          String
  windowKey         String
  direction         Direction
  engine            PredictionEngine   @default(RULE_BASED)
  modelName         String?
  confidence        Int
  entryLow          Decimal            @db.Decimal(16, 6)
  entryHigh         Decimal            @db.Decimal(16, 6)
  targetPrice       Decimal            @db.Decimal(16, 6)
  /// TP3. Set on managed trades: a third off at TP1 (+1R, derived), TP2
  /// (targetPrice) and TP3; the stop trails to entry, then to TP1.
  /// Stored in the column first created as "target2Price".
  target3Price      Decimal?           @map("target2Price") @db.Decimal(16, 6)
  invalidationPrice Decimal            @db.Decimal(16, 6)
  rationale         String
  factors           Json
  session           String
  // Day-trader extensions (v2 engine). Nullable so historic rows stay valid.
  playbook          String?
  timeframeBias     Json?
  stopPips          Decimal?           @db.Decimal(12, 2)
  targetPips        Decimal?           @db.Decimal(12, 2)
  riskReward        Decimal?           @db.Decimal(8, 2)
  atrPips           Decimal?           @db.Decimal(12, 2)
  /// TOUCH (null on older rows) or M15_CLOSE: see EntryTrigger in model.ts.
  entryTrigger      String?
  /// High-impact news windows [{from, to, title}] (ms) in which no entry fills.
  noEntryWindows    Json?
  /// Why a Neutral call stood aside (see ReasonCode in model.ts).
  reasonCode        String?
  /// Rule snapshot this signal was built with (strategy.ts).
  strategy          Json?
  /// Market conditions at publish (regime, volatility, news) for analytics.
  features          Json?
  /// Set on a "hold" call: the still-open earlier signal this window manages
  /// instead of publishing a duplicate entry.
  continuesId       Int?
  validFrom         DateTime
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  pair              CurrencyPair       @relation(fields: [pairCode], references: [code], onDelete: Cascade)
  outcome           PredictionOutcome?
  userTrades        UserTrade[]

  @@unique([pairCode, windowKey])
  @@index([pairCode, validFrom, expiresAt])
  @@index([validFrom])
}

model PredictionOutcome {
  id            Int           @id @default(autoincrement())
  predictionId  Int           @unique
  status        OutcomeStatus @default(PENDING)
  resolvedPrice Decimal?      @db.Decimal(16, 6)
  movementPips  Decimal?      @db.Decimal(12, 2)
  evaluatedAt   DateTime?
  source        OutcomeSource @default(DEMO)
  note          String?
  /// Why it ended without a position, or was cancelled (ReasonCode).
  reasonCode    String?
  /// The engine's own entry: confirming close (M15_CLOSE) or zone midpoint.
  fillPrice     Decimal?      @db.Decimal(16, 6)
  filledAt      DateTime?
  prediction    Prediction    @relation(fields: [predictionId], references: [id], onDelete: Cascade)
}

model MarketEvent {
  id            Int         @id @default(autoincrement())
  externalId    String      @unique
  currency      String
  title         String
  eventDate     DateTime
  impact        EventImpact
  forecast      String?
  previousValue String?
  createdAt     DateTime    @default(now())

  @@index([eventDate])
}

enum WeeklyBias {
  BULLISH
  BEARISH
  NEUTRAL
}

/**
 * Weekend analysis for the coming trading week. One row per pair per ISO
 * week (weekKey like "2026-W40"). Generated top-down (monthly → H1) while
 * the market is closed; served read-only all week.
 */
model WeeklyOutlook {
  id          Int              @id @default(autoincrement())
  weekKey     String
  pairCode    String
  bias        WeeklyBias
  confidence  Int
  headline    String
  narrative   String
  supports    Json
  resistances Json
  scenarios   Json
  catalysts   Json
  tradingPlan String
  engine      PredictionEngine @default(RULE_BASED)
  modelName   String?
  weekStart   DateTime
  weekEnd     DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([weekKey, pairCode])
  @@index([weekKey])
}

/**
 * A user's own record of acting on a signal ("I took this trade"). Prices are
 * optional: a trade can be logged before it is closed. Results are computed
 * from entry/exit and the side, never stored.
 */
model UserTrade {
  id           Int        @id @default(autoincrement())
  userId       Int
  predictionId Int
  side         Direction
  entryPrice   Decimal?   @db.Decimal(16, 6)
  exitPrice    Decimal?   @db.Decimal(16, 6)
  lots         Decimal?   @db.Decimal(10, 2)
  /// The user's own protective levels; when set, the exit is detected
  /// automatically from the price path.
  stopPrice    Decimal?   @db.Decimal(16, 6)
  targetPrice  Decimal?   @db.Decimal(16, 6)
  exitedAt     DateTime?
  /// "stop" | "target" when detected automatically, "manual" when typed in,
  /// "mt5" when synced from MetaTrader.
  exitReason   String?
  notes        String?
  /// "mt5" for trades synced from MetaTrader; null when logged by hand.
  source       String?
  /// MT5 position ids behind this trade (comma-separated).
  externalRef  String?
  /// Broker commission and swap in account currency (MT5), or the user's
  /// configured commission for hand-logged trades.
  commission   Decimal?   @db.Decimal(12, 2)
  swap         Decimal?   @db.Decimal(12, 2)
  /// Live spread (pips) when the trade was synced or logged.
  spreadPips   Decimal?   @db.Decimal(8, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@unique([userId, predictionId])
  @@index([userId, createdAt])
}

/// In-app notification (the bell), one row per user per alert.
model Notification {
  id           Int       @id @default(autoincrement())
  userId       Int
  kind         String
  title        String
  body         String
  predictionId Int?
  createdAt    DateTime  @default(now())
  readAt       DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Browser push endpoint (Web Push / VAPID).
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Each signal event is announced once (entry filled, target hit, ...).
model SignalEvent {
  id           Int      @id @default(autoincrement())
  predictionId Int
  kind         String
  createdAt    DateTime @default(now())

  @@unique([predictionId, kind])
}

/// A failed email/push delivery, for the admin page.
model AlertFailure {
  id        Int      @id @default(autoincrement())
  userId    Int?
  channel   String
  kind      String
  error     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A backtest of the rule engine over past months (see src/lib/backtest.ts).
/// The newest DONE run is published on the track record page.
model BacktestRun {
  id         Int       @id @default(autoincrement())
  status     String
  months     Int
  from       DateTime
  to         DateTime
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    Json?
  trades     Json?
  error      String?
  /// Rule snapshot the run replayed (strategy.ts).
  strategy   Json?

  @@index([createdAt])
}

/// MetaTrader 5 read-only sync: one key per user, used by the FXSignal Sync EA.
model Mt5Link {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  /// sha256 of the sync key; the key itself is shown once and never stored.
  tokenHash     String    @unique
  tokenHint     String
  createdAt     DateTime  @default(now())
  lastSyncAt    DateTime?
  lastAccount   String?
  lastBroker    String?
  lastPositions Int?
  lastMatched   Int?
  /// Account snapshot from the last sync (equity-based sizing, drawdown pause).
  lastBalance   Decimal?  @db.Decimal(16, 2)
  lastEquity    Decimal?  @db.Decimal(16, 2)
  lastCurrency  String?
  /// Highest equity seen, for the drawdown pause.
  peakEquity    Decimal?  @db.Decimal(16, 2)
}

/// Live bid/ask reported by an MT5 terminal (the FXSignal Sync EA).
model SpreadSample {
  id         Int      @id @default(autoincrement())
  pairCode   String
  bid        Decimal  @db.Decimal(16, 6)
  ask        Decimal  @db.Decimal(16, 6)
  spreadPips Decimal  @db.Decimal(8, 2)
  at         DateTime
  broker     String?
  userId     Int?

  @@index([pairCode, at])
}

/// Forward paper trading: what a candidate model (e.g. the zone model) would
/// have published, recorded but never shown as a signal. Settled from the
/// same cached candles as live signals; see paper.ts.
model PaperSignal {
  id                Int       @id @default(autoincrement())
  model             String
  pairCode          String
  windowKey         String
  direction         Direction
  confidence        Int
  entryLow          Decimal   @db.Decimal(16, 6)
  entryHigh         Decimal   @db.Decimal(16, 6)
  targetPrice       Decimal   @db.Decimal(16, 6)
  target3Price      Decimal?  @db.Decimal(16, 6)
  invalidationPrice Decimal   @db.Decimal(16, 6)
  stopPips          Decimal   @db.Decimal(12, 2)
  entryTrigger      String
  noEntryWindows    Json?
  zoneLabel         String?
  strategy          Json?
  features          Json?
  session           String
  validFrom         DateTime
  expiresAt         DateTime
  /// PENDING until settled; then HIT, MISSED, EXPIRED (no position or time exit).
  status            String    @default("PENDING")
  filledAt          DateTime?
  fillPrice         Decimal?  @db.Decimal(16, 6)
  movementPips      Decimal?  @db.Decimal(12, 2)
  /// After the assumed spread + slippage.
  r                 Decimal?  @db.Decimal(8, 2)
  reasonCode        String?
  note              String?
  settledAt         DateTime?
  createdAt         DateTime  @default(now())

  @@unique([model, pairCode, windowKey])
  @@index([status, expiresAt])
}
