PORT=4004
# Extra allowed browser origins, comma-separated (https://fxsignal-frontend.vercel.app
# and localhost are always allowed).
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fxsignal
# Secret used to sign session tokens. Required when NODE_ENV=production
# (generate with: openssl rand -hex 32).
JWT_SECRET=

# External market context providers. Keep these values server-side only.
TWELVE_DATA_API_KEY=
# Trading Economics credentials are commonly issued as client:secret.
TRADING_ECONOMICS_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# The analysis is a reasoning workload and takes ~70s; the response is streamed
# so the connection is not dropped while the model thinks. The token budget
# covers reasoning as well as the answer — too low and the JSON is truncated.
DEEPSEEK_TIMEOUT_MS=150000
DEEPSEEK_MAX_TOKENS=12000
# Twelve Data bills 1 credit per request. Keep this below your plan's
# per-minute cap (8 on Basic) so requests queue instead of being rejected.
TWELVE_DATA_CREDITS_PER_MINUTE=6
# Where the restart-safe market-data cache is written. Defaults to
# backend/.cache/market-cache.json.
# MARKET_CACHE_FILE=
# Minimum minutes between M15 refreshes while a signal or trade is open
# (tracking + alerts run on each M15 close). 1 Twelve Data credit per pair per
# refresh: 15 → ~4/hour per pair while something is open. 0 disables.
LIVE_PROGRESS_REFRESH_MINUTES=15
LIVE_DATA_ENABLED=false
AI_ANALYSIS_ENABLED=false

# ---- Alerts ----------------------------------------------------------------
# Link used in alert emails.
APP_URL=https://fxsignal-frontend.vercel.app
# Email (any SMTP provider). Gmail: smtp.gmail.com, port 465, your address as
# SMTP_USER and a Google "app password" as SMTP_PASS. Leave empty to disable.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FXSignal <you@example.com>"
# Browser push. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Owner console (/admin, optionally a separate admin-only site):
# comma-separated emails of accounts with access. Enforced by the API on every
# /api/admin call — the frontend layout is only a separate surface.
# For a fully separate admin domain: deploy a second frontend with
# VITE_ADMIN_ONLY=1 on e.g. admin.example.com and add that origin to
# FRONTEND_URL below.
ADMIN_EMAILS=
# Twelve Data daily credit allowance, shown on the admin page (free plan: 800).
TWELVE_DATA_CREDITS_PER_DAY=800
