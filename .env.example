PORT=4004
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fxsignal
# Secret used to sign session tokens. Required when NODE_ENV=production
# (generate with: openssl rand -hex 32).
JWT_SECRET=

# External market context providers. Keep these values server-side only.
TWELVE_DATA_API_KEY=
# Trading Economics credentials are commonly issued as client:secret.
TRADING_ECONOMICS_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# The analysis is a reasoning workload and takes ~70s; the response is streamed
# so the connection is not dropped while the model thinks. The token budget
# covers reasoning as well as the answer — too low and the JSON is truncated.
DEEPSEEK_TIMEOUT_MS=150000
DEEPSEEK_MAX_TOKENS=12000
# Twelve Data bills 1 credit per request. Keep this below your plan's
# per-minute cap (8 on Basic) so requests queue instead of being rejected.
TWELVE_DATA_CREDITS_PER_MINUTE=6
# Where the restart-safe market-data cache is written. Defaults to
# backend/.cache/market-cache.json.
# MARKET_CACHE_FILE=
# How often (minutes) to refresh M15 candles for live signal progress while a
# signal is open. 1 Twelve Data credit per pair per refresh; 0 disables.
LIVE_PROGRESS_REFRESH_MINUTES=30
LIVE_DATA_ENABLED=false
AI_ANALYSIS_ENABLED=false
